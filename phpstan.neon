parameters:
	level: 8

	paths:
		- src
		- tests
		- docs/reference

	scanDirectories:
		- tests/fixtures/plugin/src

	excludePaths:
		- tests/*/fixtures/*
		- tests/corpus/*

	ignoreErrors:
		# a first-class callable reaches the analysis only as a node of PHPStan's own; should PHPStan stop making
		# them, the branch is dead, the callable goes unseen as any unknown node does, and the test of Types says so
		-
			identifier: phpstanApi.instanceofAssumption
			path: src/Analyses/Types.php
		# the trait declaring a method is told only by the method reflection of PHPStan's own; should it change,
		# the method is taken for one of the class using the trait
		-
			identifier: phpstanApi.instanceofAssumption
			path: src/Analyses/Declarations.php
		# the cache of anonymous classes is internal; should it be renamed or dropped, nothing is emptied, which costs
		# memory, not a wrong answer
		-
			identifier: phpstanApi.classConstant
			path: src/Analyses/PhpStan.php
