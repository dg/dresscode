parameters:
	level: 8

	paths:
		- src
		- tests
		- docs/reference

	scanDirectories:
		- tests/fixtures/plugin/src

	excludePaths:
		- tests/*/fixtures/*
		- tests/corpus/*

	ignoreErrors:
		# the class phpstan/extension-installer generates and the cache of anonymous classes are internal; should either
		# be renamed or dropped, the extensions go unread or nothing is emptied, which costs what the extensions add to
		# the types or memory, not a wrong answer
		-
			identifier: phpstanApi.classConstant
			path: src/Analyses/PhpStan.php
