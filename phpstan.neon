includes:
	- tools/phpstan/extension.neon

parameters:
	level: 8

	paths:
		- src
		- tests
		- tools

	excludePaths:
		analyseAndScan:
			- tests/*/fixtures/*
			- tests/PhpSyntax/Parser/corpus/*
		analyse:
			# semantic actions index the untyped value stack; their shape is given by the grammar and checked by the round-trip tests
			- src/PhpSyntax/Parser/ParserData.php

	ignoreErrors:
		-	# rule numbers come from the generated Action tables, so they always index the generated rule tables
			message: '#^Offset .* might not exist on non-empty-list<int>\.$#'
			path: src/PhpSyntax/Parser/Parser.php
