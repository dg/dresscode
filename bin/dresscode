#!/usr/bin/env php
<?php declare(strict_types=1);

// the project's autoloader first: a copy installed from a path repository brings its own vendor along
foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $file) {
	if (is_file($file)) {
		require $file;
		break;
	}
}

if (!class_exists(DressCode\Console\Application::class)) {
	fwrite(STDERR, "Error: DressCode is not installed; install it with 'composer require --dev dresscode/dresscode'.\n");
	exit(2);
}

// a 500 kB file peaks at about 100 MB; the ini default of 128M is too close for comfort
$limit = DressCode\Engine\Helpers::findMemoryLimit();
if ($limit !== null && $limit < 512 * 1024 ** 2) {
	ini_set('memory_limit', '512M');
}

exit((new DressCode\Console\Application)->run($argv));
