extensions:
	- Acme\DressCode\Extension

presets:
	- dresscode/psr12
	- acme/default

rules:
	dresscode/line-length: {maxLength: 160}
	dresscode/strict-comparison: true
	dresscode/yoda: keep

indent: tab
eol: LF
php: '8.3'
paths: [src, tests]
excludePaths: [build, docs/generated]
warnings: [dresscode/line-length]
fileExtensions: [php, phpt]
baseline: dresscode-baseline.neon
cacheDir: temp/dresscode
analyses:
	- Acme\DressCode\Analyses\FunctionCalls
