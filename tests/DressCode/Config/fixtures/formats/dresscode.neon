extensions:
	- Acme\DressCode\Extension
	- Acme\DressCode\Rules\NoVarDumpRule

presets:
	- dresscode/psr12
	- acme/default

groups:
	- cleanup
	- types

rules:
	dresscode/line-length: {ignoreImports: false}
	dresscode/strict-comparison: true
	dresscode/yoda: keep

indent: tab
eol: LF
lineLength: 160
php: '8.3'
namespaces:
	functions: [App\helper, 'App\Utils\{format, parse}']
	constants: [App\LIMIT]
nameResolution: certain
fixRisky: [dresscode/strict-call]
warnings: [dresscode/line-length]

overrides:
	- paths: [tests]
	  presets: [dresscode/nette]
	  rules: {dresscode/line-length: keep}
	  nameResolution: uncertain

paths: [src, tests]
excludePaths: [build, docs/generated]
fileExtensions: [php, phpt]
baseline: dresscode-baseline.neon
cacheDir: temp/dresscode
analyses:
	- Acme\DressCode\Analyses\FunctionCalls
