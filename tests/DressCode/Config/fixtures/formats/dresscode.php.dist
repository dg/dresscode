<?php declare(strict_types=1);

use DressCode\Config;

return Config::create()
	->extension(Acme\DressCode\Extension::class)
	->preset('dresscode/psr12')
	->preset('acme/default')
	->enable('dresscode/line-length', ['maxLength' => 160])
	->enable('dresscode/strict-comparison')
	->disable('dresscode/yoda')
	->indent('tab')
	->eol('LF')
	->php('8.3')
	->paths(['src', 'tests'])
	->excludePaths(['build', 'docs/generated'])
	->override(['tests'], ['dresscode/line-length' => false])
	->warnings(['dresscode/line-length'])
	->fileExtensions(['php', 'phpt'])
	->baseline('dresscode-baseline.neon')
	->cacheDir('temp/dresscode')
	->analysis(Acme\DressCode\Analyses\FunctionCalls::class);
