	->where('event.startDate > NOW()')
	->where('booking.price > 0')
// ->where('booking.note', '')
// ->where('booking.id IN', [])
;

// without them the semicolon closes the last line
$rows = $facade->getRows()
	->where('price > 0');

// a comment below another statement is no link of a chain
