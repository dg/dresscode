<?php
if ($a) {
	foo();
		// introduces the else
} else {
	bar();
}

do {
	foo();
		// introduces the while
} while ($a);

if ($a) {
	foo();
		// closes the block
}
while ($a) {
	foo();
}

try {
	foo();
	// ends the try
} catch (Exception $e) {
	bar();

	// ends the catch

} finally {
	baz();
}

if ($a) {
	foo();
	// ends the if
} elseif ($b) {
	bar();
	// ends the elseif
	// on two lines
} else {
	baz();
}
