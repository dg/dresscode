<?php

// a ternary choosing the call where the array has an item and null otherwise is the new function alone
function truthy(array $a)
{
	return array_first($a);
}


function negated(array $a)
{
	return array_last($a);
}


function notEmptyArray(array $a)
{
	return array_first($a);
}


function emptyArray(array $a)
{
	return array_last($a);
}


function counted(array $a)
{
	return array_first($a);
}


function countAboveZero(array $a)
{
	return array_first($a);
}


function countZero(array $a)
{
	return array_last($a);
}


function emptied(array $a)
{
	return array_first($a);
}


function notEmptied(array $a)
{
	return array_last($a);
}


// a variable holding the array only to pass it by reference is the argument
function temporary(string $name)
{
	$label = array_last(explode('/', $name));
	return $label;
}


// left as risky
function falseBranch(array $a)
{
	return $a ? array_first($a) : false;
}


function swappedBranches(array $a)
{
	return $a ? null : reset($a);
}


function property(\Acme\Shop\Catalog $catalog)
{
	return $catalog->items ? reset($catalog->items) : null;
}


function readLater(string $name)
{
	$parts = explode('/', $name);
	$last = end($parts);
	return $last . count($parts);
}


function inLoop(array $lists)
{
	foreach ($lists as $list) {
		$item = explode(',', $list);
		$item = end($item);
		echo $item;
	}
}


function compacted(string $name)
{
	$vars = compact('name');
	$label = explode('/', $name);
	$label = end($label);
	return $label;
}


// a comment between the two keeps them apart
function commented(string $name)
{
	$label = explode('/', $name);
	// the last part
	$label = array_last($label);
	return $label;
}
