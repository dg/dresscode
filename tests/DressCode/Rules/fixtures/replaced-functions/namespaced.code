<?php
// {"Acme\\Template\\escape": "Acme\\Template\\escape_html", "Acme\\Template\\raw": "trim"}

namespace Acme\Template {
	function render(string $text): string
	{
		return escape($text) . raw($text) . \Acme\Template\escape($text);
	}
}


namespace App {
	use function Acme\Template\escape;
	use Acme\Template;

	function show(string $text): string
	{
		return escape($text) . Template\escape($text) . \Acme\Template\raw($text);
	}


	function other(string $text): string
	{
		return \App\escape($text);
	}
}
