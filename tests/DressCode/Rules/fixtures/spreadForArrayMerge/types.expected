namespace App;

use Acme\Shop\Cart;


function merge(array $defaults, array $options, iterable $extra, Cart $cart): array
{
	return [
		[...$defaults, ...$options],
		[...$defaults, ...$extra],
		array_merge($defaults, $cart),
	];
}


function languages(array $languages): void
{
	$a = [
		...$languages,
		'bg', 'de', 'es', 'fr', 'hu', 'it', 'pl', 'pt', 'ru', 'tr', 'uk', 'ja', 'el', 'ro', 'sl',
	];
	$b = [
		...$languages,
		...[5 => 'x'],
		'k' => 'y', 'l' => 'z',
	];
	$c = [...$languages, 'bg', 'de'];
}
