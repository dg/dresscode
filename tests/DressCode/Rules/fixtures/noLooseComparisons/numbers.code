<?php

namespace App;


function numbers(int $count, float $ratio, int|float $amount, string $label): array
{
	$delta = round($ratio / 60);
	return [
		$delta == 0,
		$delta != 1,
		$count == 1.0,
		$ratio == 2,
		$ratio == -0,
		$ratio <> -3,
		$count == -2.0,
		0 == $ratio,
		1. != $count,
		$ratio == 1_000,
		$count == 9007199254740991.0,

		// left alone
		$count == 1.5,
		$count == 9007199254740992.0,
		$count == -9007199254740992.0,
		$ratio == 0x10,
		$ratio == 017,
		$count == 1e3,
		$label == 1,
		$amount == 0,
	];
}
