<?php
// {"api": {"replacedClasses": {"App\\Old": "App\\Current"}}}

namespace App;

use App\Old;

// a name left as it is keeps the import only where it reaches the class through it
function route(string $class, array $map): array
{
	return [
		new Old,
		$class === \App\Old::class,
		$map[namespace\Old::class],
	];
}
