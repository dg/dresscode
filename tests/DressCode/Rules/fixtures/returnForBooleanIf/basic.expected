<?php
function a($x) {
	return $x > 1;
}
function b($x) {
	return !($x > 1);
}
function c($x) {
	if ($x) {
		return true;
	}
	return false;
}
function d($x) {
	if ($x > 1) {
		return true;
	}
	return true;
}
function e($x) {
	if ($x > 1) {
		// comment
		return true;
	}
	return false;
}
function f($x) {
	if ($x > 1) {
		return true;
	} elseif ($x) {
		return false;
	}
	return false;
}
function g($x) {
	if ($x > 1) {
		return true;
	}
	return $x;
}
function h($x) {
	if (!$x) {
		return false;
	}

	return true;
}
function i($x) {
	return !$x;
}
function j($x) { return $x > 1;  }
