<?php
// {"Acme\\Container::addUpload($name, $label, true)": "addMultiUpload($name, $label)", "Acme\\Control::getOption($key, $default)": "getOption($key) ?? $default", "Acme\\Callback::closure($callable)": "\\Closure::fromCallable($callable)"}

namespace App;

use Acme\Callback;
use Acme\Container;

function build(Container $form, callable $handler): void
{
	$upload = $form->addUpload('photos', 'Photos', true);
	$class = $upload->getOption('class', 'upload') . ' multiple';
	$closure = Callback::closure($handler);
}
