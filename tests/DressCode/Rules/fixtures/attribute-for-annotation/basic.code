namespace App;

use Acme\Attributes\Access;

class ProductController
{
	/** @cached */
	public int $page = 1;

	/**
	 * The language of the page.
	 * @cached
	 */
	public string $lang = 'en';

	/** @cached */
	#[Deprecated]
	public string $view = 'grid';


	/**
	 * @secured
	 * @param  array<string>  $items
	 */
	public function sort(array $items): void
	{
	}


	/**
	 * @cached
	 * @secured
	 */
	public function both(): void
	{
	}


	/** @filter */
	public function shortify(string $s): string
	{
		return $s;
	}


	// left alone: the attribute is there already, a withdrawn entry, another annotation
	/** @secured */
	#[Access(public: false)]
	public function done(): void
	{
	}


	/**
	 * @kept
	 * @return void
	 */
	public function other(): void
	{
	}


	// reported: nothing says where the text would go
	/** @cached across requests */
	public string $note = '';

	// reported: after a name the parentheses are text too, not the arguments of a Doctrine annotation
	/** @cached(menu) */
	public string $menu = '';
}
