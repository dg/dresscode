<?php

function checkFloatKeys(array $rows, float $ratio, int|float $number, int|string $key, float|string $mixed, ArrayAccess $access): void
{
	$a = [1 => 'x', 2.0 => 'y', 3 => 'z'];
	$b = $rows[(int) $ratio];
	$c = $rows[$number];
	$d = $rows[$key];
	$e = $rows[$mixed];
	$f = $access[$ratio];
