<?php

namespace App;

use Nette\Forms\Form;

class MyForm extends Form
{
	public function check(): void
	{
		$this->invalidateControl();
		$x = self::FILLED;
		$y = static::EQUAL;
	}
}


function test(Form $form, MyForm $my, $unknown): void
{
	$a = $form::FILLED;
	$b = Form::FILLED;
	$c = MyForm::FILLED;
	$d = $form::Filled;
	$form->invalidateControl();
	$form?->invalidateControl();
	$e = Form::OLD;
	$f = Form::EMAIL;
	Form::make();
	$g = $form->legacy;
	$h = $form?->legacy;
	$i = $form->items;
	$j = Form::$counter;
	$k = MyForm::$count;
	$unknown->invalidateControl();
	$unknown::FILLED;
}
