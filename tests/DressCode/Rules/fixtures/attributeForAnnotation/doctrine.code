namespace App\Controller;

use Acme\Http\Annotation\Endpoint;
use Acme\Marked;
use Acme\Security\Annotation\RequiresRole;
use Acme\Validation as Check;

/**
 * @Endpoint("/blog", name="blog_")
 */
class BlogController
{
	/**
	 * Lists the posts.
	 *
	 * @Endpoint("/{page}", name="index", patterns={"page"="\d+"}, verbs={"GET", "HEAD"}, defaults={"format"="html"}, weight=-1)
	 * @RequiresRole("user")
	 */
	public function index(int $page = 1): void
	{
	}


	/**
	 * @Endpoint(path="/new", name="new", guard=null, protocols={"https"}, flags={"utf8"=true})
	 */
	public function create(): void
	{
	}
}


class Post
{
	public const MaxTitle = 100;

	/**
	 * @Check\Required
	 * @Check\Size(min=3, max=Post::MaxTitle, message="Too short, ""really"" it's")
	 */
	public string $title = '';

	/**
	 * @Check\Each({
	 *     @Check\Required,
	 *     @Check\Size(min=5)
	 * })
	 */
	public array $tags = [];

	/**
	 * @Marked(1)
	 * @Check\Size(3, 4)
	 * @Check\Size(min=3) and some text
	 * @Check\Group
	 * @Check\Missing
	 */
	public string $refused = '';

	#[Check\Size(min: 3)]
	public string $attribute = '';
}
