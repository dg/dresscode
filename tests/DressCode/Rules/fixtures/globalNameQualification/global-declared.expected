<?php
// {"globalFunction":["imported","bare"],"globalConstant":["imported","bare"]}
namespace App;

use function strlen;

const PHP_EOL = "\n";

function ini_set(string $option, string $value)
{
	return \ini_set($option, $value);
}

function f($x)
{
	ini_set('a', 'b');
	strlen($x);
	echo PHP_EOL;
}
