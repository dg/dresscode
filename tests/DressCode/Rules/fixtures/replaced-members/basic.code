<?php
// {"Nette\\Forms\\Form::FILLED": "Filled", "Nette\\Forms\\Form::invalidateControl": "redrawControl", "Nette\\Forms\\Form::$legacy": "$items", "Nette\\Forms\\Form::$counter": "$count", "Nette\\Forms\\Form::OLD": "Nette\\Forms\\Helpers::Renewed", "Nette\\Forms\\Form::make()": "Nette\\Forms\\Helpers::create()", "Nette\\Utils\\Strings::contains": "\\str_contains", "Nette\\Forms\\Form::hook": "attached", "Nette\\Forms\\Form::GONE": "Nette\\Missing\\Thing::Here", "Nette\\Forms\\Form::measure": "\\strlen", "Nette\\Forms\\Form::moved()": "Nette\\Forms\\Helpers::create", "Nette\\Forms\\Form::WITHDRAWN": "keep", "Nette\\Forms\\Form::unProtect": "unprotect", "Nette\\Forms\\Form::build": "Nette\\Forms\\Helpers::create"}

namespace App;

use Nette\Forms\Form;
use Nette\Utils\Strings;

class MyForm extends Form
{
	public function hook(object $parent): void
	{
		parent::hook($parent);
		$a = self::FILLED;
		$b = static::OLD;
		$this->invalidateControl();
		$c = self::build(); // a static method moves to another class
		$d = static::make(); // one the class no longer has may be a method of the object
	}


	public function moved(): void
	{
	}
}


function test(Form $form, MyForm $my, Form|\stdClass $union, $unknown): void
{
	$a = Form::FILLED;
	$b = $form::FILLED;
	$c = MyForm::FILLED;
	$my->invalidateControl(1, named: 2);
	$form?->INVALIDATECONTROL();
	$d = $form->legacy;
	$e = Form::$counter;
	$f = Form::OLD;
	$g = \Nette\Forms\Form::OLD;
	$h = Form::make();
	$i = Strings::contains('abc', needle: 'b');
	$j = Strings::contains(...);
	$k = $form->measure('x') . 'y';
	$s = [
		Form::OLD,
		$form::OLD,
	];
	$t = $form->unProtect() . $form->unprotect(); // renamed in its letter case alone

	// left alone: a receiver that may be something else, a member of another kind, the new name, a withdrawn entry
	$union->invalidateControl();
	$unknown->invalidateControl();
	$l = Form::Filled;
	$m = $form->FILLED;
	$n = Form::WITHDRAWN;

	// reported with the reason
	$o = $form->make();
	$p = Form::GONE;
	$q = $form?->measure('x');
	$r = Form::create()->measure('x');
}
