<?php
// risky
final class A
{
	public readonly string $name;

	public function __construct(string $name)
	{
		$this->name = $name;
	}
}

final class B
{
	public readonly string $name;

	public function __construct(string $name)
	{
		$this->name = $name;
	}
}

final class WithTrait
{
	use Resets;

	private int $value;

	public function __construct()
	{
		$this->value = 1;
	}
}

final class Child extends Base
{
	protected int $inherited;

	private readonly int $own;

	public function __construct()
	{
		$this->inherited = 1;
		$this->own = 1;
	}
}

$x = new class extends Base {
	public int $inherited;

	public function __construct()
	{
		$this->inherited = 1;
	}
};
