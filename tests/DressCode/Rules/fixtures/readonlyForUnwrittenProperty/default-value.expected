<?php
// php 8.6
final class Pager
{
	private readonly int $limit = 10;
	private int $page = 1;
	private readonly int $size = 20;
	private readonly string $label = 'pager';
	private $untyped = 1;
	private static int $count = 0;

	public function next(): static
	{
		$this->page++;
		return clone($this, ['limit' => $this->limit * 2]);
	}


	public function getLabel(): string
	{
		return $this->label . $this->limit;
	}
}

final class Sized
{
	private int $size = 20;
	private readonly int $set;


	public function __construct(int $size)
	{
		$this->size = $size;
		$this->set = $size;
	}
}

class Open
{
	public int $limit = 10;
	private readonly int $own = 1;
}
