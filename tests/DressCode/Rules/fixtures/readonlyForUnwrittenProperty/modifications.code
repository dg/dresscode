<?php
final class Twice
{
	private int $value;

	public function __construct()
	{
		$this->value = 1;
		$this->value = 2;
	}
}

final class PromotedAssigned
{
	public function __construct(private int $value = 1)
	{
		$this->value = 2;
	}
}

final class InLoop
{
	private int $value;

	public function __construct(array $items)
	{
		foreach ($items as $item) {
			$this->value = $item;
		}
	}
}

final class Branches
{
	private int $value;

	public function __construct(bool $flag)
	{
		if ($flag) {
			$this->value = 1;
		}
	}
}

final class InPlace
{
	private string $combined;
	private array $element;
	private array $sorted;
	private array $pushed;
	private array $matches;
	private array $iterated;
	private array $referenced;
	private array $own;
	private array $kept;

	public function __construct()
	{
		$this->combined = 'a';
		$this->combined .= 'b';
		$this->element = [];
		$this->element[] = 1;
		$this->sorted = [2, 1];
		$this->pushed = [];
		$this->matches = [];
		$this->iterated = [1];
		$this->referenced = [1];
		$this->own = [1];
		$this->kept = [2, 1];
	}


	public function change(): void
	{
		sort($this->sorted);
		array_push($this->pushed, 1);
		preg_match('#a#', 'a', $this->matches);
		foreach ($this->iterated as &$item) {
		}

		$reference = &$this->referenced;
		$this->fill($this->own);
		echo count($this->kept), implode(',', $this->kept);
		foreach ($this->kept as $item) {
		}
	}


	private function fill(array &$items): void
	{
	}
}

final class Dynamic
{
	private int $value;

	public function __construct(string $name)
	{
		$this->value = 1;
		$this->$name = 5;
	}
}

final class Destructured
{
	private int $first;
	private int $second;

	public function __construct(array $pair)
	{
		[$this->first, $this->second] = $pair;
	}
}
