final class A
{
	private(set) string $a;
	public private(set) string $b;
	protected(set) string $c;
	public protected(set) int $d;
	public private(set) static int $s;
	public string $e;

	public function __construct(string $a, string $b, string $c, int $d, string $e)
	{
		$this->a = $a;
		$this->b = $b;
		$this->c = $c;
		$this->d = $d;
		$this->e = $e;
	}
}
