<?php

namespace App;

use Acme\Zoo\Keeper;


function hasSleepingAnimal(Keeper $keeper): bool
{
	return \array_any($keeper->animals, fn($animal) => $animal->isAsleep());
}


function hasSleepingHerd(Keeper $keeper): bool
{
	foreach ($keeper->herd as $animal) {
		if ($animal->isAsleep()) {
			return true;
		}
	}

	return false;
}


function hasSleepingVisitor(Keeper $keeper): bool
{
	foreach ($keeper->visitors as $animal) {
		if ($animal->isAsleep()) {
			return true;
		}
	}

	return false;
}


function feedsAll(Keeper $keeper, int $portion): bool
{
	return \array_all($keeper->animals, fn($animal) => $keeper->feeds($animal, $portion));
}


function weighsAny(Keeper $keeper, ?int $weight): bool
{
	foreach ($keeper->animals as $animal) {
		if ($keeper->weighs($animal, $weight)) {
			return true;
		}
	}

	return false;
}
