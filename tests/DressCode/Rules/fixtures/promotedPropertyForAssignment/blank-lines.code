<?php
// the blank lines the assignments stood between become one, the gap below the properties stays
class Storage
{
	public int $count = 0;
	private string $dir;
	private ?Journal $journal;

	public function __construct(string $dir, ?Journal $journal = null)
	{
		if (!is_dir($dir)) {
			throw new InvalidArgumentException;
		}

		$this->dir = $dir;
		$this->journal = $journal;

		if (mt_rand() < 10) {
			$this->clean();
		}
	}
}
