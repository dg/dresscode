braces:
	position:
		class: nextLine
		function: nextLine
		multilineSignature: sameLine
		closure: sameLine
		anonymousClass: sameLine
		controlStructure: sameLine
		continuingKeyword: sameLine
	emptyBody:
		class: expanded
		function: expanded
		closure: expanded
		propertyHook: expanded
		anonymousClass: keep
	singlelineClosure: keep
