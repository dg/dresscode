<?php
// types off
namespace App;

use Acme\Shop\Basket;

class Generated implements \IteratorAggregate
{
	#[\ReturnTypeWillChange]
	public function getIterator(): \Generator
	{
		yield 1;
	}
}

class Nested implements \IteratorAggregate
{
	#[\ReturnTypeWillChange]
	public function getIterator(): Basket
	{
		return $this->basket;
	}
}
