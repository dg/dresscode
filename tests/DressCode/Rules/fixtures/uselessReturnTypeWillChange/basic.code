<?php
namespace App;

use Traversable;

class Collection implements \Countable, \ArrayAccess, \IteratorAggregate, \JsonSerializable
{
	#[\ReturnTypeWillChange]
	public function count(): int
	{
		return 0;
	}


	#[\ReturnTypeWillChange]
	public function offsetGet($offset): ?string
	{
		return null;
	}


	#[\ReturnTypeWillChange]
	public function getIterator(): Traversable
	{
		return new \ArrayIterator([]);
	}


	#[\ReturnTypeWillChange]
	public function jsonSerialize(): array
	{
		return [];
	}


	// left alone

	#[\ReturnTypeWillChange]
	public function offsetExists($offset)
	{
		return false;
	}


	#[\ReturnTypeWillChange]
	public function offsetSet($offset, $value): bool
	{
		return true;
	}


	#[\ReturnTypeWillChange, \Deprecated]
	public function offsetUnset($offset): void
	{
	}


	#[\ReturnTypeWillChange]
	public function own(): int
	{
		return 1;
	}
}

class Other implements \Countable
{
	#[\ReturnTypeWillChange]
	public function count(): \Countable
	{
		return $this;
	}
}
