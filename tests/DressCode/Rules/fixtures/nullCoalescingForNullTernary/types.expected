<?php

namespace App;

use Acme\Shop\{Basket, Cart};


/** @param array<string, ?int> $list */
function read(Cart $cart, Basket $basket, array $list, \ArrayAccess $map): array
{
	return [
		$cart->total ?? 0,
		isset($basket->total) ? $basket->total : 0,
		$list['k'] ?? 0,
		$map['k'] !== null ? $map['k'] : 0,
	];
}
