<?php
// php 8.5
// risky
namespace App;

class Open
{
	/** @readonly */
	private int $limit = 10;

	/** @readonly */
	private int $size = 20;

	/** @readonly */
	private int $page = 1;


	public function __construct(int $size)
	{
		$this->size = $size;
	}


	public function next(): void
	{
		$this->page = 2;
	}
}

/** @readonly */
final class Settings
{
	private int $retries = 3;
	private string $name;
}

/** @readonly */
final class Counter
{
	private int $count = 0;


	public function increment(): void
	{
		$this->count++;
	}
}
