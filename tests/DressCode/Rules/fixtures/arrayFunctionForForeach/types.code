<?php

namespace App;

use Acme\Zoo\Keeper;


function hasSleepingAnimal(Keeper $keeper): bool
{
	foreach ($keeper->animals as $animal) {
		if ($animal->isAsleep()) {
			return true;
		}
	}

	return false;
}


function hasSleepingHerd(Keeper $keeper): bool
{
	foreach ($keeper->herd as $animal) {
		if ($animal->isAsleep()) {
			return true;
		}
	}

	return false;
}


function hasSleepingVisitor(Keeper $keeper): bool
{
	foreach ($keeper->visitors as $animal) {
		if ($animal->isAsleep()) {
			return true;
		}
	}

	return false;
}
