<?php
// an else that leaves needs no braces to come first
function a($x) {
	if ($x) {
		x();
		y();
	} else return;
}
function b($x) {
	foreach ($x as $y) {
		if ($y) {
			z();
		} else continue;
		w();
	}
}
function c($x) {
	if ($x) {
		x();
	}
	else throw new E;
	y();
}

// left alone: an else without braces that goes on, an if without braces
function d($x) {
	if ($x) {
		x();
	} else y();
}
function e($x) {
	if ($x) x();
	else return;
}
