<?php
// variables named as the parts of the built code
function load(Repository $repo, int $id): array
{
	$value = $repo->find($id);
	if ($value === null) {
		throw new NotFound($id);
	}

	$throw = $repo->find($id);
	if ($throw === null) {
		throw new NotFound($id);
	}

	return [$value, $throw];
}
