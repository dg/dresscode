<?php
// {"types.declaration.property": "keep"}
// risky
// php 7.4
// PHP 7.4 has no union, no `mixed` and no `static`, while a nullable type is older
namespace App;

class A
{
	/**
	 * @param int|string $a
	 * @param mixed $b
	 * @param ?int $c
	 * @return static
	 */
	public function f($a, $b, $c)
	{
		return $this;
	}
}
