function t3($o, $a, $i) {
	if ($o->next()) {
		$a[$i] = 1;
	} else {
		$a[$i] = 2;
	}
	if ($o->valid) {
		$a[$o->i] = 1;
	} else {
		$a[$o->i] = 2;
	}
	if ($o->next()) {
		$a[PHP_EOL] = 1;
	} else {
		$a[PHP_EOL] = 2;
	}
	if ($o->next()) {
		$a[Acme::Key] = 1;
	} else {
		$a[Acme::Key] = 2;
	}
	return $a;
}
