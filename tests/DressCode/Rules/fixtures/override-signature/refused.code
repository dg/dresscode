	{
		return null;
	}


	// reported and left: a required parameter, and a default no code writes
	public function draw(string $caption): void
	{
	}


	// reported and left: a function in the body may see the variable by its name
	public function setCaption(string $text): void
	{
		$fn = function () use ($text) {
