<?php
// {"Acme\\Settings::getListeners()": "$this->listeners", "Acme\\Settings::getFirstListener()": "$this->listeners[0]", "Acme\\Settings::describeAll()": "$this->describe(', ')", "Acme\\Settings::getSorted()": "getEntries()->sort()", "Acme\\Settings::countListeners()": "\\count($this->listeners)", "Acme\\Settings::getOptionOr($key, $default)": "getOption($key) ?? $default", "Acme\\Settings::getSelf()": "$this"}

namespace App;

use Acme\Settings;

function test(?Settings $settings, Settings $plain): void
{
	// a chain of accesses on the object skips a null as a whole, the operator carried over to its first link
	$a = $settings?->listeners;
	$b = $settings?->listeners[0];
	$c = $settings?->describe(', ');
	$d = $settings?->getEntries()->sort();
	$e = $plain->listeners;
	$f = $plain?->listeners['x'];

	// reported and left: the replacement would give something else than null
	$g = $settings?->countListeners();
	$h = $settings?->getOptionOr('key', 'default');
	$i = $settings?->getSelf();

	// a chain broken before its operator stays broken
	$j = $settings
		?->listeners;
	$k = $plain
		->getEntries()->sort();
}
