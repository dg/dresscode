<?php
// {"Acme\\Message::$subject::get": "getSubject()", "Acme\\Message::$sent::get": "$this->isSent() === true"}

namespace App;

use Acme\Message;

/** @param list<Message> $mails */
function test(Message $mail, array $mails): string
{
	// an interpolation takes a variable and what is read or called on it, braces written where the string has none
	$a = "Subject: {$mail->subject}";
	$b = "Subject: $mail->subject!";
	$c = "First: {$mails[0]->subject}";
	$d = <<<TEXT
		Subject: {$mail->subject}
		Again: $mail->subject
		TEXT;
	$h = "Cost: \$$mail->subject";

	// reported and left: an expression an interpolation cannot take, and braces after a dollar, which read as ${
	$e = "Sent: {$mail->sent}";
	$f = "Sent: $mail->sent";
	$i = "Cost: $$mail->subject";
	$j = "Path: \\$$mail->subject";

	// an argument of a call in an interpolation takes any expression
	$g = "Length: {$mail->pad($mail->sent)}";
	return $a . $b . $c . $d . $e . $f . $g . $h . $i . $j;
}
