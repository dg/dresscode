<?php
// risky
class Service
{
	private Clock $clock;
	private Logger $logger;


	public function __construct(?Clock $clock = null, Logger|null $logger = null)
	{
		$this->clock = $clock ?? new SystemClock;
		$this->logger = $logger;
	}


	public function format(?Formatter $formatter = null): string
	{
		$formatter ??= new Formatter(Formatter::SHORT, 'cs');
		return $formatter->format($this->clock->now());
	}


	public function convert(?Converter $converter = null): string
	{
		$converter = $converter ?? new Converter;
		return $converter->run();
	}


	public function stamp((Clock&Stringable)|null $clock = null): string
	{
		$clock ??= new SystemClock;
		return (string) $clock;
	}


	public function both(?Clock $clock = null, ?Formatter $formatter = null, ?Converter $converter = null): string
	{
		$clock ??= new SystemClock;
		$this->logger = $logger ?? new Logger;
		$formatter ??= new Formatter;
		$converter ??= new Converter;
		return $formatter->format($clock->now());
	}


	public function repeated(Clock $clock, ?Formatter $formatter = null, ?Converter $converter = null): void
	{
		$clock ??= new SystemClock;
		$formatter ??= new Formatter;
		$formatter ??= new OtherFormatter;
		$converter ??= new Converter;
	}


	public function reading(?Formatter $formatter = null, ?Converter $converter = null): void
	{
		$formatter ??= new Formatter;
		$this->converter = $converter ?? new Converter($formatter);
		$converter ??= new Converter;
	}


	// left alone

	public function withArgument(?Formatter $formatter = null, string $locale = 'cs'): string
	{
		$formatter ??= new Formatter(Formatter::SHORT, $locale);
		return $formatter->format(1);
	}


	public function notFirst(?Formatter $formatter = null): string
	{
		$x = 1;
		$formatter ??= new Formatter;
		return $formatter->format($x);
	}


	public function selfInstance(?self $other = null): void
	{
		$other ??= new self;
	}


	public function untyped($formatter = null): void
	{
		$formatter ??= new Formatter;
	}


	public function lateBound(?Clock $clock = null): void
	{
		$clock ??= new SystemClock(static::ZONE);
	}
}
