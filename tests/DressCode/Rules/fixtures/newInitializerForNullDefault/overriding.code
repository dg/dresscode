<?php
// risky

namespace App;

use Acme\Time\{Clock, Schedule, SystemClock, Task};

class Calendar extends Schedule
{
	public function __construct(?Clock $clock = null)
	{
		$clock ??= new SystemClock;
	}


	public function load(?Clock $clock = null): void
	{
		$clock ??= new SystemClock;
	}


	public function save(?Clock $clock = null): void
	{
		$clock ??= new SystemClock;
	}


	private function plan(?Clock $clock = null): void
	{
		$clock ??= new SystemClock;
	}
}


class Job extends Task
{
	public function __construct(?Clock $clock = null)
	{
		$clock ??= new SystemClock;
	}
}


trait Timed
{
	public function at(?Clock $clock = null): void
	{
		$clock ??= new SystemClock;
	}
}


trait Stamped
{
	abstract public function at(?Clock $clock = null): void;
}


class Diary
{
	use Stamped;

	public function at(?Clock $clock = null): void
	{
		$clock ??= new SystemClock;
	}
}
