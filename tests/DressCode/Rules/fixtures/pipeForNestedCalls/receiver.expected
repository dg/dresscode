<?php
function f(Text $o, string $input)
{
	$a = trim(make()->clean(strtolower($input)));
	$b = $input |> strtolower(...) |> $o->clean(...) |> trim(...);
	$c = $input |> make()->clean(...) |> strtolower(...) |> trim(...);
	$d = trim(strtolower(make()->clean($input++)));
}


function make(): Text
{
	return new Text;
}
