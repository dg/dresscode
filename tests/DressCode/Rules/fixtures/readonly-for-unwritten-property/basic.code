<?php
final class A
{
	private string $name;
	protected int $count;
	public string $title;
	private string $changed;
	private string $appended;
	private $untyped;
	private static string $shared;
	private string $withDefault = 'x';
	private string $never;

	public function __construct(string $name, private int $price)
	{
		$this->name = $name;
		$this->count = 1;
		$this->title = 'a';
		$this->changed = 'a';
		$this->appended = 'b';
		$this->untyped = 'c';
		self::$shared = 'd';
		$this->withDefault = 'e';
	}


	public function rename(string $name): void
	{
		$this->changed = $name;
	}


	public function grow(): void
	{
		$this->appended .= '!';
	}
}

