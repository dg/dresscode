<?php
// php 8.4
class A
{
	public string $a { &get => $this->a; }
	public string $b { final get => $this->b; final set { $this->b = $value; } }
	public string $c {
		get => $this->c;
		set( string  $value ) { $this->c = $value; }
	}
	public string $d { set( string  $value ) { $this->d = $value; } }
	public string $e
	{
		get => $this->e;


		set { $this->e = $value; }
	}
	public string $f {
		#[Attr]
		get => 'f';
		#[Attr]
		set { $this->f = $value; }
	}
	public function __construct(public string $g { get => $this->g; set( string  $value ) { $this->g = $value; } }, public int $h { get => 1; }) {}
}
abstract class B
{
	abstract public string $a { get; set; }
	abstract public string $b { get; }
	public abstract string $c
	{
		get;
		set;
	}
}
interface I
{
	public string $a { get; set; }
	public string $b { get; }
}
