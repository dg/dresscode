<?php
// php 8.4
final class Point
{
	final public int $x = 0;

	public int $y {
		final get => 1;
	}
}

class Account
{
	final private(set) int $balance = 0;
	public protected(set) readonly int $id;
	private private(set) int $secret = 0;
	public public(set) readonly int $exact;
	protected protected(set) int $counted = 0;

	final public int $total {
		final get => 1;
	}

	public function __construct(
		protected(set) readonly int $only,
	) {
	}
}

readonly class Money
{
	public function __construct(
		protected(set) readonly int $amount,
	) {
	}
}
