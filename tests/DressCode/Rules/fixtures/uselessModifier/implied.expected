<?php
// php 8.4
final class Point
{
	public int $x = 0;

	public int $y {
		get => 1;
	}
}

class Account
{
	private(set) int $balance = 0;
	public readonly int $id;
	private int $secret = 0;
	public public(set) readonly int $exact;
	protected int $counted = 0;

	final public int $total {
		get => 1;
	}

	public function __construct(
		readonly int $only,
	) {
	}
}

readonly class Money
{
	public function __construct(
		readonly int $amount,
	) {
	}
}
