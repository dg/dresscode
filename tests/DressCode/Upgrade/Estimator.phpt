<?php declare(strict_types=1);

use DressCode\Config;
use DressCode\Upgrade\{BlindSpots, Estimate, Estimator, Phase, Project, Target, Topic};
use Tester\Assert;

require __DIR__ . '/../../bootstrap.php';


/** A project on PHP ^8.0 whose code meets the data of PHP, the sets and the names of its namespace. */
function createEstimatedProject(string $name): string
{
	$root = createTempDir($name);
	mkdir("$root/src");
	file_put_contents("$root/composer.json", '{"require": {"php": "^8.0"}}');
	file_put_contents("$root/src/Code.php", <<<'XX'
		<?php

		namespace App;

		function run($handle, string $date, int $count = null): bool
		{
			curl_close($handle);
			strftime($date);
			chmod($date, 0755);
			return strpos($date, 'x') !== false;
		}
		XX);
	return $root;
}


/** @return list<string>  every topic as `name set phase files: automatic types names manual` */
function describeTopics(Estimate $estimate): array
{
	return array_map(
		fn(Topic $topic) => "$topic->name $topic->set {$topic->phase->value} $topic->files: " . implode(' ', $topic->places),
		$estimate->topics,
	);
}


test('the places are told by topic, by phase and by what the run can do about them, the jump first', function () {
	$root = createEstimatedProject('estimate');
	file_put_contents(
		"$root/src/Dynamic.php",
		"<?php\n\nfunction call(object \$object, string \$method): void\n{\n\t\$object->\$method();\n}\n",
	);
	file_put_contents("$root/src/Generated.php", "<?php\n// @generated by Acme Builder, do not edit\n\nstrftime('%Y');\n");
	file_put_contents("$root/src/default.latte", "{\$title}\n");
	$estimate = new Estimator(new Project(new Config(paths: ['src']), $root))->estimate([Target::php('8.4')]);

	// curl_close() does nothing since 8.0 already, strftime() has no replacement, `0o` needs 8.1, `?int` works on 8.0
	Assert::same([
		'php deprecations jump 1: 0 0 0 1',
		'upgrading.syntax.octalPrefix modernizations jump 1: 1 0 0 0',
		'php deprecations bridge 1: 1 0 0 0',
		'upgrading.functions.substringFunctions modernizations bridge 1: 1 0 0 0',
		'upgrading.php.implicitNullable deprecations bridge 1: 1 0 0 0',
	], describeTopics($estimate));
	Assert::same(2, $estimate->files);
	// what the upgrade cannot see is counted apart from the topics, and a generated file is left out
	Assert::equal(new BlindSpots(dynamicAccesses: 1, otherFiles: ['latte' => 1], generatedFiles: 1), $estimate->blindSpots);
	Assert::true($estimate->namesMeasured);
	Assert::false($estimate->types);
	Assert::same(['php' => '8.6'], $estimate->knownVersions);
	// without a lock nothing is asked of Composer
	Assert::same([], $estimate->blockers);
});


test('where the configuration says the names are uncertain, a fix of a call of a function waits for them', function () {
	$root = createEstimatedProject('estimate-uncertain');
	$config = new Config(paths: ['src'], nameResolution: 'uncertain');
	$estimate = new Estimator(new Project($config, $root))->estimate([Target::php('8.4')]);

	Assert::false($estimate->namesMeasured);
	Assert::contains('php deprecations bridge 1: 0 0 1 0', describeTopics($estimate));
	Assert::contains('upgrading.functions.substringFunctions modernizations bridge 1: 0 0 1 0', describeTopics($estimate));
});


test('without a target the rules of a newer PHP stay off, what it retires is reported, and the project stays as it was', function () {
	$root = createEstimatedProject('estimate-today');
	$before = hash_file('xxh128', "$root/src/Code.php");
	$estimate = new Estimator(new Project(new Config(paths: ['src']), $root))->estimate([]);

	Assert::same(['php'], array_map(fn(Topic $topic) => $topic->name, $estimate->findTopics(Phase::Jump)));
	Assert::same($before, hash_file('xxh128', "$root/src/Code.php"));
});



test('the targets proposed are PHP and every library whose data know a newer version than the project allows', function () {
	$root = createEstimatedProject('estimate-targets');
	$estimator = new Estimator(new Project(new Config(paths: ['src']), $root));

	Assert::equal([Target::php('8.6')], $estimator->proposeTargets());
	Assert::equal([Target::php('8.6')], $estimator->proposeTargets(phpOnly: true));
});
