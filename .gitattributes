.gitattributes  export-ignore
.github/        export-ignore
.gitignore      export-ignore
AGENTS.md       export-ignore
ncs.*           export-ignore
dresscode.php   export-ignore
phpstan*.neon   export-ignore
docs/           export-ignore
grammar/        export-ignore
tests/          export-ignore
tools/          export-ignore

*.php*          diff=php
*.sh            text eol=lf
bin/dresscode   text eol=lf
# byte-exact: these files are the input and the oracle of round-trip and rule tests,
# so a checkout must never rewrite their line endings
tests/PhpSyntax/Parser/corpus/**  -text
tests/PhpSyntax/Parser/dump/**    -text
tests/**/fixtures/**       -text
