presets:
	- nette

groups:
	- modernization
	- deprecations

rules:
	group-import: {minImports: 2}
	override-attribute-required: keep

types: phpstan

paths:
	- src
	- tests
	- bin/dresscode
	- docs/reference/generate.php

excludePaths:
	- fixtures
	- tests/corpus

fileExtensions:
	- php
	- phpt

overrides:
	- paths: [src]
	  groups: [optimized-calls]
	  nameResolution: certain
	  rules:
	  	name-fallback: {optimizedFunctions: qualified, optimizedConstants: qualified}

	- paths: [src/Analyses/PhpSymbolsData.php]
	  rules:
	  	class-name-reference-for-string-literal: keep
