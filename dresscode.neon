use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests
	- bin/dresscode
	- docs/reference/generate.php

excludePaths:
	- fixtures
	- tests/corpus
	- tests/**/output

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}
indentation: {ternaryBelowCondition: aligned, binaryOperator: keep}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations

	- # the class names of PHP are the data of the generated list, not references to code
		paths: [src/Analyses/PhpSymbolsData.php]
		literals:
			classNameInString: keep
