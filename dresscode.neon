use:
	- nette
	- modernizations

paths:
	- src
	- tests
	- bin/dresscode

excludePaths:
	- fixtures
	- tests/corpus
	- tests/**/output

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
