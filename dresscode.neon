presets:
	- nette

rules:
	group-import: {minImports: 2}
	strict-comparison: true
	final-internal-class: true

fixRisky:
	- strict-call
	- modern-class-name-reference
	- strict-types-required
	- strict-comparison
	- final-internal-class
	- no-trailing-whitespace-in-string
	- explicit-assertion
	- increment-operator

paths:
	- src
	- tests
	- bin/dresscode
	- docs/reference/generate.php

excludePaths:
	- fixtures
	- tests/corpus

fileExtensions:
	- php
	- phpt

overrides:
	- paths: [src]
	  groups: [optimized-calls]
	  rules:
	  	name-fallback: {optimizedFunctions: qualified, optimizedConstants: qualified}
	  nameResolution: certain
