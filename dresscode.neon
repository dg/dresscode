presets:
	- nette

risky: yes

rules:
	strict-comparison: true
	final-internal-class: true
	ternary-for-simple-branch: true

paths:
	- src
	- tests
	- bin/dresscode
	- docs/reference/generate.php

excludePaths:
	- fixtures
	- corpus

fileExtensions:
	- php
	- phpt

overrides:
	- paths: [src]
	  rules: {global-imports: {functions: optimized}}

	# a test opens with its own header and stands the bootstrap apart from the imports
	- paths: [tests/**.phpt]
	  rules: {dresscode/blank-lines: {afterImports: 2}}
