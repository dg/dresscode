{
	"name": "dresscode/dresscode",
	"description": "👔 DressCode: checks and fixes PHP coding style, and upgrades code to newer PHP and to new versions of libraries. Built on a lossless syntax tree, so it changes only what it touches. PER Coding Style, PSR-12, Nette.",
	"keywords": ["code style", "coding standard", "formatter", "fixer", "linter", "refactoring", "modernization", "upgrade", "deprecations", "psr-12", "per-cs", "php-cs-fixer", "phpcs", "rector"],
	"homepage": "https://dresscode.run",
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"nette/command-line": "^2.0",
		"nette/neon": "^3.4 || ^4.0",
		"nette/schema": "^1.4 || ^2.0",
		"nette/utils": "^4.1",
		"phpsyntax/phpsyntax": "^1.0",
		"phpstan/phpdoc-parser": "^2.4",
		"composer/semver": "^3.4"
	},
	"require-dev": {
		"nette/tester": "^2.7",
		"tracy/tracy": "^2.12",
		"phpstan/phpstan": "^2.3",
		"phpstan/extension-installer": "^1.4",
		"nette/phpstan-rules": "^1.0"
	},
	"conflict": {
		"phpstan/phpstan": "<2.3.4"
	},
	"bin": ["bin/dresscode"],
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"DressCode\\": "src"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s",
		"reference": "php docs/reference/generate.php",
		"api": "php docs/reference/api.php"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.3-dev"
		}
	}
}
