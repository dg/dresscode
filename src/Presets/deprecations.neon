# Deprecations
#
# What a newer PHP deprecated or removed, fixed where a replacement exists and reported where none does, and what the
# upgrading files of the installed packages list as retired. A deprecation is reported whatever the target, the code
# meeting it wherever it runs on the version that made it.

classes:
	overridingMethod:
		signature: required                   # a child matching a parent changed by an upgrade
		parameterName: required

expressions:
	cast: canonical                           # `(int)`, not `(integer)`, PHP 8.5

# what a library or PHP breaks in a major version, reported
mistakes:
	finalParent: forbidden                    # a class extending a final one
	unimplementedAbstractMethod: forbidden
	__serialize: required                     # beside `Serializable`, PHP 8.1

upgrading:
	packages: yes                             # as the upgrading files of the packages say
	declarations:
		deprecatedClass: forbidden            # by what `@deprecated` names
		deprecatedMember: forbidden
		deprecatedFunction: forbidden
	php:
		nullArrayKey: forbidden               # `['' => 1]`, not `[null => 1]`, PHP 8.5
		nullArgument: forbidden               # `trim($text ?? '')`, not `trim($text)` of a null, PHP 8.1
		floatArrayKey: forbidden              # `$a[(int) $ratio]`, not `$a[$ratio]` of a float, PHP 8.1
		caseSemicolon: forbidden              # `case 1:`, not `case 1;`, PHP 8.5
		implicitNullable: forbidden           # `?int $x = null`, not `int $x = null`, PHP 8.4
		deprecatedApi: forbidden              # `mb_convert_encoding()`, not `utf8_encode()`, `E_STRICT` reported
		deprecatedArgument: forbidden         # `trigger_error($m, E_USER_ERROR)` reported
		constructorReturnValue: forbidden     # PHP 8.6
		sleepAndWakeup: forbidden             # `__serialize()`, PHP 8.5
		returnInFinally: forbidden            # PHP 8.6
		csvEscapeArgument: required           # the `escape` of `fgetcsv()` written out, PHP 8.4
		dollarBraceInterpolation: forbidden   # `{$name}`, not `${name}`, PHP 8.2
		reservedNames: forbidden              # `let`, `is`, `_`, PHP 8.6
		backticks: forbidden                  # `shell_exec()`, PHP 8.5
	syntax:
		firstClassCallables: required         # `foo(...)`, not `Closure::fromCallable('foo')`
