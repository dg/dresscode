# Modernizations
#
# The construct a newer PHP has, written where an older one says the same, each where the target version of the
# project has it, and the newer form the upgrading files of the installed packages offer. It decides nothing about the
# layout, so it goes with any standard.

functions:
	closureReturningOneExpression: forbidden         # `fn() =>` instead
	closureReturningOneExpressionNested: yes         # also one holding another closure

cleanup:
	classNameNotation: classKeyword            # `self::class`, `static::class`

controlFlow:
	ifReturning:
		oneOfTwoValues: forbidden              # `return $c ? 1 : 2;`

expressions:
	assignment:
		repeatingTarget: forbidden             # `$a += $b`, not `$a = $a + $b`
	ternary:
		testingNull: forbidden                 # `$a ?? $b`
		returningItsCondition: forbidden       # `$a ?: $b`
	separate:
		isset: forbidden                       # `isset($a, $b)`
		unset: forbidden                       # `unset($a, $b);`

literals:
	longArraySyntax: forbidden                 # `[1, 2]`, not `array(1, 2)`

upgrading:
	libraries:
		packages: adopted                      # as the upgrading files of the packages say
	php:
		sleepAndWakeup: forbidden              # `__serialize()` and `__unserialize()` instead
	syntax:
		spreadForArrayMerge: adopted           # `[...$a, ...$b]`, not `array_merge($a, $b)`
		dynamicClassConstant: adopted          # `X::{$name}`, not `constant("X::$name")`
		match: adopted                         # for a `switch` returning or assigning
		throwExpression: adopted               # `$a ?? throw new E`
		cloneWith: adopted                     # `clone($o, [...])`
		nullsafe: adopted                      # `$a?->b`, not `$a ? $a->b : null`
		pipe:
			nestedCalls: adopted               # `$x |> a(...) |> b(...)`, not `b(a($x))`
		newWithoutWrapping: adopted            # `new Foo()->bar()`, not `(new Foo())->bar()`
		firstClassCallables: adopted           # `foo(...)`, not `Closure::fromCallable('foo')`
		octalPrefix: adopted                   # `0o17`, not `017`
		newInInitializer: adopted              # `Clock $c = new SystemClock`, not a `null` swapped in the body
		promotedProperties: adopted
	functions:
		array_is_list: adopted
		arraySearchFunctions: adopted          # `array_find()`, `array_any()` for a `foreach`
		arrayFirstLast: adopted                # `array_first()`, not `reset()`
		clamp: adopted                         # `clamp($x, $lo, $hi)`, not `max($lo, min($x, $hi))`
		get_debug_type: adopted
		json_validate: adopted                 # not `json_decode()` only testing
		substringFunctions: adopted            # `str_contains()`, not `strpos() !== false`
		roundingMode: adopted                  # `RoundingMode::HalfAwayFromZero`, not `PHP_ROUND_HALF_UP`
	phpdoc:
		deprecated: adopted                    # `#[\Deprecated]`, not `@deprecated`
