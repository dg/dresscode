# Modernizations
#
# The construct a newer PHP has, written where an older one says the same, each where the target version of the
# project has it, and the newer form the upgrading files of the installed packages offer. It decides nothing about the
# layout, so it goes with any standard.

classes:
	instantiationWrapping: forbidden           # `new Foo()->bar()`, not `(new Foo())->bar()`

functions:
	arrowFunction:
		oneExpression: required                # `fn() =>` for a closure only returning
	arrowFunctionNested: yes                   # also one holding another closure

hygiene:
	classNameNotation:
		currentClass: 'self::class'            # `self::class`, `static::class`
		object: '$object::class'               # not `get_class($o)`, PHP 8.0

expressions:
	ternary:
		short: required                        # `$a ?: $b`
	coalesce: required                         # `$a ?? $b`

literals:
	arraySyntax: short                         # `[1, 2]`, `[$a] =`

upgrading:
	libraries:
		packageData: yes                       # as the upgrading files of the packages say
	php:
		sleepAndWakeup: forbidden              # `__serialize()` and `__unserialize()` instead
	syntax:
		spreadForArrayMerge: required          # `[...$a, ...$b]`, not `array_merge($a, $b)`
		dynamicClassConstant: required         # `X::{$name}`, not `constant("X::$name")`
		match: required                        # for a `switch` returning or assigning
		throwExpression: required              # `$a ?? throw new E`
		cloneWith: required                    # `clone($o, [...])`
		nullsafe: required                     # `$a?->b`, not `$a ? $a->b : null`
		pipe: required                         # `$x |> a(...) |> b(...)`, not `b(a($x))`
		firstClassCallables: required          # `foo(...)`, not `Closure::fromCallable('foo')`
		octalPrefix: required                  # `0o17`, not `017`
		newInInitializer: required             # `Clock $c = new SystemClock`, not a `null` swapped in the body
		promotedProperties: required
		readonlyClasses: required              # `readonly class`, not `readonly` on every property
	classes:
		Stringable: required                   # on a class with `__toString()`, PHP 8.0
	functions:
		array_is_list: required
		arraySearchFunctions: required         # `array_find()`, `array_any()` for a `foreach`
		arrayFirstLast: required               # `array_first()`, not `reset()`
		clamp: required                        # `clamp($x, $lo, $hi)`, not `max($lo, min($x, $hi))`
		get_debug_type: required
		json_validate: required                # not `json_decode()` only testing
		substringFunctions: required           # `str_contains()`, not `strpos() !== false`
		roundingMode: required                 # `RoundingMode::HalfAwayFromZero`, not `PHP_ROUND_HALF_UP`
	phpdoc:
		deprecated: required                   # `#[\Deprecated]`, not `@deprecated`
